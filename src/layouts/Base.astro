---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
const {
  title = 'שרון שגיא · עיצוב פנים ותכנון הבית',
  description = 'שרון שגיא — סטודיו אישי לעיצוב פנים ותכנון הבית בנופית. הקשבה, התבוננות ותכנון מדויק.',
  active = '',
  solidNav = false,
  slimFooter = false,
  ogImage = '/assets/og-sharon.jpg',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
---
<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/png" href="/assets/mark.png" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="he_IL" />
  <meta property="og:site_name" content="שרון שגיא" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Rubik:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet" />
</head>
<body class={solidNav ? 'has-solid-nav' : ''}>
  <Nav active={active} solid={solidNav} />
  <a href="#main" class="skip-link">דלג לתוכן הראשי</a>
  <main id="main">
    <slot />
  </main>
  <Footer slim={slimFooter} />
  <script>
    const nav = document.getElementById('nav');
    const isStatic = nav.classList.contains('is-static');
    if (!isStatic) {
      const onScroll = () => nav.classList.toggle('solid', window.scrollY > window.innerHeight * 0.7);
      addEventListener('scroll', onScroll); onScroll();
    }
    const toggle = document.getElementById('navToggle');
    const links = document.getElementById('navLinks');
    toggle?.addEventListener('click', () => links.classList.toggle('open'));
    links?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => links.classList.remove('open')));
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.15 });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

    // Project cards. Hover/focus reveal is pure CSS. On touch there is no hover,
    // so the first tap reveals the title + house mark and the second tap opens
    // the project. The decision is made per interaction from the event's own
    // pointerType, not from a matchMedia check at load time -- that check was
    // wrong on hybrid and trackpad-equipped touch devices, which is why the
    // title sometimes failed to appear and it took extra taps to get in.
    const cards = document.querySelectorAll('.proj__card, .pcard');
    cards.forEach((card) => {
      card.addEventListener('pointerdown', (e) => { card.dataset.touch = e.pointerType === 'touch' ? '1' : '0'; });
      card.addEventListener('click', (e) => {
        if (card.dataset.touch !== '1') return;          // mouse, pen, keyboard: go straight in
        if (card.classList.contains('is-open')) return;  // second tap: go straight in
        e.preventDefault();
        cards.forEach((c) => { if (c !== card) { c.classList.remove('is-open'); c.dataset.touch = '0'; } });
        card.classList.add('is-open');
      });
    });
  </script>
</body>
</html>
