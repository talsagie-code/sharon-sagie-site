<script define:vars={{ ENDPOINT, MAX_FILE_MB, MAX_TOTAL_MB }}>
  const form = document.getElementById('qForm');
  const steps = [...form.querySelectorAll('.step')];
  const last = steps.length - 1;
  const barFill = document.getElementById('barFill');
  const pct = document.getElementById('pct');
  const stepLabel = document.getElementById('stepLabel');
  const backBtn = document.getElementById('backBtn');
  const nextBtn = document.getElementById('nextBtn');
  const doneEl = document.getElementById('done');
  const footEl = document.getElementById('foot');
  const sending = document.getElementById('sending');
  const failEl = document.getElementById('fail');
  const STORE = 'ss_questionnaire_v1';
  let i = 0;
  let picked = [];

  document.getElementById('maxMb').textContent = MAX_FILE_MB;

  /* ---------- restore / persist ---------- */
  const save = () => {
    try {
      const d = {};
      form.querySelectorAll('input,textarea').forEach((el) => {
        if (el.type === 'file') return;
        if (el.type === 'checkbox' || el.type === 'radio') { if (el.checked) (d[el.name] = d[el.name] || []).push(el.value); }
        else if (el.value) d[el.name] = el.value;
      });
      localStorage.setItem(STORE, JSON.stringify({ d, i }));
    } catch (e) {}
  };
  const restore = () => {
    try {
      const raw = localStorage.getItem(STORE); if (!raw) return;
      const { d, i: si } = JSON.parse(raw);
      form.querySelectorAll('input,textarea').forEach((el) => {
        if (el.type === 'file') return;
        const v = d[el.name]; if (v === undefined) return;
        if (el.type === 'checkbox' || el.type === 'radio') { if (Array.isArray(v) && v.includes(el.value)) el.checked = true; }
        else el.value = v;
      });
      if (typeof si === 'number' && si > 0 && si <= last) i = si;
      form.querySelectorAll('[data-reveal]').forEach(syncReveal);
      updateTop5();
    } catch (e) {}
  };

  /* ---------- reveal "אחר" ---------- */
  function syncReveal(el) {
    const box = document.getElementById(el.dataset.reveal); if (!box) return;
    let on = el.checked;
    if (el.type === 'radio') on = form.querySelector('input[name="' + CSS.escape(el.name) + '"][data-reveal="' + el.dataset.reveal + '"]:checked') !== null;
    box.classList.toggle('on', !!on);
  }
  form.addEventListener('change', (e) => {
    const t = e.target;
    if (t.type === 'radio') form.querySelectorAll('input[type=radio][name="' + CSS.escape(t.name) + '"][data-reveal]').forEach(syncReveal);
    if (t.dataset && t.dataset.reveal) syncReveal(t);
    updateTop5();
    save();
  });
  form.addEventListener('input', save);

  /* ---------- max 5 ---------- */
  const top5 = [...form.querySelectorAll('input[name="5 הדברים החשובים"]')];
  const counter = document.getElementById('top5Counter');
  function updateTop5() {
    if (!top5.length) return;
    const n = top5.filter((c) => c.checked).length;
    counter.querySelector('b').textContent = n;
    counter.classList.toggle('full', n >= 5);
    top5.forEach((c) => { c.disabled = !c.checked && n >= 5; });
  }

  /* ---------- files ---------- */
  const drop = document.getElementById('drop');
  const fileInput = document.getElementById('files');
  const flist = document.getElementById('flist');
  const fnote = document.getElementById('fnote');
  const fileErr = document.getElementById('fileErr');
  let files = [];
  const fmt = (b) => b < 1048576 ? Math.max(1, Math.round(b / 1024)) + ' KB' : (b / 1048576).toFixed(1) + ' MB';

  function renderFiles() {
    flist.innerHTML = '';
    files.forEach((f, idx) => {
      const row = document.createElement('div');
      row.className = 'frow';
      const n = document.createElement('span'); n.className = 'frow__n'; n.textContent = f.name;
      const s = document.createElement('span'); s.className = 'frow__s'; s.textContent = fmt(f.size);
      const x = document.createElement('button'); x.type = 'button'; x.className = 'frow__x';
      x.setAttribute('aria-label', 'הסרה'); x.textContent = '×';
      x.addEventListener('click', () => { files.splice(idx, 1); renderFiles(); });
      row.append(n, s, x); flist.appendChild(row);
    });
    const total = files.reduce((a, f) => a + f.size, 0);
    fnote.textContent = files.length ? files.length + ' קבצים · ' + fmt(total) + ' סה״כ' : '';
  }
  function addFiles(list) {
    fileErr.classList.remove('on'); fileErr.textContent = '';
    const ok = ['application/pdf', 'image/jpeg', 'image/png'];
    const msgs = [];
    [...list].forEach((f) => {
      if (!ok.includes(f.type)) { msgs.push('"' + f.name + '" – פורמט לא נתמך'); return; }
      if (f.size > MAX_FILE_MB * 1048576) { msgs.push('"' + f.name + '" – גדול מ־' + MAX_FILE_MB + 'MB'); return; }
      const total = files.reduce((a, x) => a + x.size, 0);
      if (total + f.size > MAX_TOTAL_MB * 1048576) { msgs.push('"' + f.name + '" – חורג מהמקסימום הכולל'); return; }
      if (files.some((x) => x.name === f.name && x.size === f.size)) return;
      files.push(f);
    });
    if (msgs.length) { fileErr.textContent = msgs.join(' · ') + '. אפשר לשלוח אותו בנפרד למייל sharonsa.design@gmail.com'; fileErr.classList.add('on'); }
    renderFiles();
  }
  drop.addEventListener('click', () => fileInput.click());
  drop.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileInput.click(); } });
  fileInput.addEventListener('change', () => { addFiles(fileInput.files); fileInput.value = ''; });
  ['dragenter', 'dragover'].forEach((ev) => drop.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.add('over'); }));
  ['dragleave', 'drop'].forEach((ev) => drop.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.remove('over'); }));
  drop.addEventListener('drop', (e) => addFiles(e.dataTransfer.files));

  /* ---------- validation ---------- */
  function validate(stepEl) {
    let ok = true;
    stepEl.querySelectorAll('.q[data-required="1"]').forEach((q) => {
      const err = q.querySelector('.err');
      let filled;
      const radios = q.querySelectorAll('input[type=radio]');
      if (radios.length) filled = [...radios].some((r) => r.checked);
      else filled = [...q.querySelectorAll('input[type=text],textarea')].some((f) => f.value.trim() !== '');
      q.classList.toggle('invalid', !filled);
      if (err) err.classList.toggle('on', !filled);
      if (!filled && ok) { ok = false; q.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
    });
    return ok;
  }

  /* ---------- navigation ---------- */
  function show(n) {
    steps[i].classList.remove('on');
    i = n;
    steps[i].classList.add('on');
    const p = Math.round((i / last) * 100);
    barFill.style.width = p + '%';
    pct.textContent = p + '%';
    stepLabel.textContent = steps[i].dataset.title || '';
    backBtn.classList.toggle('btn--hidden', i === 0);
    nextBtn.textContent = i === 0 ? 'מתחילים' : (i === last ? 'סיימנו, אפשר לשלוח' : 'הבא');
    window.scrollTo({ top: 0, behavior: 'smooth' });
    save();
  }
  backBtn.addEventListener('click', () => { if (i > 0) show(i - 1); });
  nextBtn.addEventListener('click', () => {
    if (!validate(steps[i])) return;
    if (i < last) show(i + 1); else submit();
  });

  /* ---------- submit ---------- */
  const readAsB64 = (file) => new Promise((res, rej) => {
    const r = new FileReader();
    r.onload = () => res(String(r.result).split(',')[1]);
    r.onerror = rej;
    r.readAsDataURL(file);
  });

  function collect() {
    const out = [];
    form.querySelectorAll('.step').forEach((st) => {
      st.querySelectorAll('.q').forEach((q) => {
        const label = q.dataset.q; if (!label) return;
        const vals = [];
        q.querySelectorAll('input[type=checkbox],input[type=radio]').forEach((c) => { if (c.checked) vals.push(c.value); });
        q.querySelectorAll('input[type=text],textarea').forEach((f) => { if (f.value.trim()) vals.push(f.value.trim()); });
        if (vals.length) out.push({ part: st.dataset.part || '', q: label, a: vals.join(' · ') });
      });
    });
    return out;
  }

  async function post(payload) {
    const r = await fetch(ENDPOINT, {
      method: 'POST',
      headers: { 'Content-Type': 'text/plain;charset=utf-8' },
      body: JSON.stringify(payload),
    });
    const t = await r.text();
    let j; try { j = JSON.parse(t); } catch (e) { throw new Error('bad response'); }
    if (!j.ok) throw new Error(j.error || 'server error');
    return j;
  }

  async function submit() {
    if (!ENDPOINT || ENDPOINT.indexOf('PASTE_') === 0) {
      failEl.innerHTML = 'הטופס עדיין לא חובר לשליחה. אנא צרו קשר עם שרון.';
      failEl.classList.add('on');
      return;
    }
    failEl.classList.remove('on');
    nextBtn.disabled = true; backBtn.disabled = true;
    sending.classList.add('on');
    const msg = document.getElementById('sendMsg');
    const answers = collect();
    const name = (form.querySelector('#f_names') || {}).value || 'ללא שם';

    try {
      msg.textContent = 'שולח את התשובות…';
      const first = await post({ type: 'answers', name: name, answers: answers, files: files.length });
      const token = first.token;

      for (let k = 0; k < files.length; k++) {
        msg.textContent = 'מעלה קובץ ' + (k + 1) + ' מתוך ' + files.length + '…';
        const b64 = await readAsB64(files[k]);
        await post({ type: 'file', token: token, name: name, filename: files[k].name, mime: files[k].type, data: b64 });
      }

      msg.textContent = 'מסיים…';
      await post({ type: 'finish', token: token, name: name });

      try { localStorage.removeItem(STORE); } catch (e) {}
      sending.classList.remove('on');
      form.style.display = 'none';
      footEl.style.display = 'none';
      document.querySelector('.q-top').style.display = 'none';
      doneEl.classList.add('on');
      window.scrollTo({ top: 0 });
    } catch (err) {
      sending.classList.remove('on');
      nextBtn.disabled = false; backBtn.disabled = false;
      failEl.innerHTML = 'משהו השתבש בשליחה. התשובות שלכם נשמרו בדפדפן – אפשר לנסות שוב בעוד רגע, או לשלוח אותן ישירות למייל <a href="mailto:sharonsa.design@gmail.com">sharonsa.design@gmail.com</a>';
      failEl.classList.add('on');
    }
  }

  /* ---------- init ---------- */
  restore();
  show(i);
  renderFiles();
</script>

</body>
</html>
