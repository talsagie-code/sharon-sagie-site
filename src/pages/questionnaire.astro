---
// שאלון פגישת ייעוץ תכנוני — Make it Right
// עמוד עצמאי, לא מקושר מהתפריט ולא נסרק ע"י מנועי חיפוש (noindex).
// השליחה עוברת ל-Google Apps Script של שרון: תשובות -> Google Sheet,
// קבצים -> תיקייה ב-Drive, ובנוסף מייל מסודר. ראו QUESTIONNAIRE-SETUP.md
const ENDPOINT = 'PASTE_APPS_SCRIPT_URL_HERE';
const MAX_FILE_MB = 18;
const MAX_TOTAL_MB = 60;
---

<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>שאלון לקראת פגישת ייעוץ תכנוני · שרון שגיא</title>
  <meta name="description" content="שאלון קצר לקראת פגישת הייעוץ התכנוני" />
  <link rel="icon" type="image/png" href="/assets/mark.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@300;400;500&family=Frank+Ruhl+Libre:wght@300;400;500&display=swap" rel="stylesheet" />
</head>
<body>

<style is:global>
  :root{
    --bg:#F7F4EF; --bg-2:#F1EDE6; --paper:#FFFFFF;
    --ink:#2A2420; --ink-soft:#6E665B; --ink-faint:#9A9186;
    --line:#E4DCD1;
    --clay:#AE5A3C; --clay-deep:#8C4630; --clay-tint:#F6EBE5;
    --moss:#5B6B60; --moss-deep:#44534A; --moss-tint:#EAEFEB;
    --r:14px;
    --sans:'Rubik',system-ui,sans-serif;
    --display:'Frank Ruhl Libre',Georgia,serif;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{-webkit-text-size-adjust:100%}
  body{background:var(--bg);color:var(--ink);font-family:var(--sans);font-weight:300;
       line-height:1.75;-webkit-font-smoothing:antialiased;overflow-x:hidden}
  img{display:block;max-width:100%}
  ::selection{background:var(--clay);color:#fff}
  :focus-visible{outline:3px solid var(--clay-deep);outline-offset:3px;border-radius:6px}

  /* ---------- shell ---------- */
  .q-top{position:sticky;top:0;z-index:20;background:rgba(247,244,239,.94);
         backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
  .q-top__in{max-width:760px;margin:0 auto;padding:14px 22px 0;
             display:flex;flex-direction:column;align-items:center;gap:10px}
  .q-logo{width:186px;height:auto}
  .q-bar{width:100%;height:3px;background:var(--line);border-radius:99px;overflow:hidden}
  .q-bar__fill{height:100%;width:0;background:var(--moss);border-radius:99px;
               transition:width .55s cubic-bezier(.2,.7,.2,1)}
  .q-meta{width:100%;display:flex;justify-content:space-between;align-items:center;
          padding-bottom:10px;font-size:.72rem;letter-spacing:.1em;color:var(--ink-faint)}
  .q-meta strong{font-weight:400;color:var(--moss-deep)}

  main{max-width:760px;margin:0 auto;padding:0 22px 140px}

  /* ---------- steps ---------- */
  .step{display:none;padding:52px 0 8px;animation:rise .5s cubic-bezier(.2,.7,.2,1) both}
  .step.on{display:block}
  @keyframes rise{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
  @media (prefers-reduced-motion:reduce){.step{animation:none}}

  .eyebrow{font-family:var(--sans);font-size:.72rem;letter-spacing:.24em;
           color:var(--moss-deep);text-transform:uppercase}
  .step h2{font-family:var(--display);font-weight:400;font-size:clamp(1.65rem,4.4vw,2.3rem);
           line-height:1.25;letter-spacing:-.01em;margin:12px 0 0}
  .step__note{color:var(--ink-soft);font-size:1rem;margin-top:12px;max-width:56ch}

  /* ---------- intro ---------- */
  .intro h1{font-family:var(--display);font-weight:300;font-size:clamp(2rem,6vw,3.1rem);
            line-height:1.2;letter-spacing:-.015em;margin:14px 0 0}
  .intro h1 em{font-style:normal;color:var(--clay-deep)}
  .intro p{color:var(--ink-soft);margin-top:20px;font-size:1.05rem;max-width:58ch}
  .intro .rule{width:56px;height:1px;background:var(--clay);opacity:.6;margin:30px 0}
  .intro__pill{display:inline-flex;align-items:center;gap:9px;background:var(--moss-tint);
               color:var(--moss-deep);border-radius:99px;padding:8px 16px;font-size:.85rem;margin-top:26px}

  /* ---------- questions ---------- */
  .q{margin-top:38px}
  .q:first-of-type{margin-top:34px}
  .q__label{display:block;font-size:1.08rem;font-weight:400;color:var(--ink);line-height:1.6}
  .q__hint{display:block;color:var(--ink-soft);font-size:.9rem;margin-top:6px;font-weight:300}
  .req{color:var(--clay);font-size:.85rem;margin-inline-start:4px}
  .opt{color:var(--ink-faint);font-size:.78rem;margin-inline-start:8px;letter-spacing:.04em}

  input[type=text],input[type=tel],input[type=email],textarea,select{
    width:100%;margin-top:14px;background:var(--paper);border:1px solid var(--line);
    border-radius:var(--r);padding:14px 16px;font-family:inherit;font-size:1rem;font-weight:300;
    color:var(--ink);transition:border-color .25s,box-shadow .25s;line-height:1.6}
  input::placeholder,textarea::placeholder{color:#BCB3A7}
  textarea{min-height:118px;resize:vertical}
  input:focus,textarea:focus,select:focus{border-color:var(--clay);
    box-shadow:0 0 0 4px rgba(174,90,60,.09);outline:none}
  .in-short{max-width:280px}
  .ltr{direction:ltr;text-align:right}

  /* choice chips */
  .opts{display:flex;flex-wrap:wrap;gap:10px;margin-top:16px}
  .opts--col{flex-direction:column;align-items:stretch}
  .opt-item{position:relative}
  .opt-item input{position:absolute;inset:0;opacity:0;width:100%;height:100%;margin:0;cursor:pointer}
  .opt-item span{display:block;background:var(--paper);border:1px solid var(--line);
    border-radius:99px;padding:11px 20px;font-size:.97rem;color:var(--ink);
    transition:.22s cubic-bezier(.2,.7,.2,1);cursor:pointer;user-select:none}
  .opts--col .opt-item span{border-radius:var(--r);padding:14px 18px}
  @media (hover:hover){.opt-item:hover span{border-color:#CDBFB2}}
  .opt-item input:checked + span{background:var(--clay-tint);border-color:var(--clay);
    color:var(--clay-deep);font-weight:400}
  .opt-item input:focus-visible + span{outline:3px solid var(--clay-deep);outline-offset:2px}
  .opt-item input:disabled + span{opacity:.42;cursor:not-allowed}

  .counter{margin-top:14px;font-size:.85rem;color:var(--ink-soft)}
  .counter b{font-weight:400;color:var(--clay-deep)}
  .counter.full b{color:var(--moss-deep)}

  .other-wrap{margin-top:12px;display:none}
  .other-wrap.on{display:block}

  .err{display:none;margin-top:12px;color:var(--clay-deep);font-size:.9rem}
  .err.on{display:block}
  .q.invalid input[type=text],.q.invalid textarea{border-color:var(--clay)}

  /* ---------- files ---------- */
  .drop{margin-top:22px;border:1.5px dashed #D3C7B9;border-radius:var(--r);background:var(--paper);
        padding:34px 22px;text-align:center;transition:.25s;cursor:pointer}
  .drop.over{border-color:var(--clay);background:var(--clay-tint)}
  .drop__t{font-size:1.02rem;color:var(--ink)}
  .drop__s{font-size:.86rem;color:var(--ink-soft);margin-top:6px}
  .drop input{display:none}
  .flist{margin-top:16px;display:flex;flex-direction:column;gap:8px}
  .frow{display:flex;align-items:center;gap:12px;background:var(--paper);border:1px solid var(--line);
        border-radius:12px;padding:11px 14px;font-size:.92rem}
  .frow__n{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .frow__s{color:var(--ink-faint);font-size:.82rem;direction:ltr;flex:0 0 auto}
  .frow__x{flex:0 0 auto;border:none;background:none;color:var(--ink-faint);cursor:pointer;
           font-size:1.15rem;line-height:1;padding:2px 4px;font-family:inherit}
  @media (hover:hover){.frow__x:hover{color:var(--clay-deep)}}
  .flist ul{list-style:none;margin:10px 0 0;padding:0}
  .flist-note{margin-top:14px;font-size:.85rem;color:var(--ink-soft)}
  .doclist{margin-top:16px;padding:0;list-style:none;display:grid;gap:7px}
  .doclist li{position:relative;padding-inline-start:18px;color:var(--ink-soft);font-size:.96rem}
  .doclist li::before{content:"";position:absolute;inset-inline-start:0;top:.72em;
    width:5px;height:5px;border-radius:50%;background:var(--clay);opacity:.65}

  /* ---------- nav ---------- */
  .q-foot{position:fixed;inset:auto 0 0 0;z-index:20;background:linear-gradient(180deg,rgba(247,244,239,0),rgba(247,244,239,.97) 34%);
          padding:22px 22px calc(20px + env(safe-area-inset-bottom))}
  .q-foot__in{max-width:760px;margin:0 auto;display:flex;align-items:center;gap:12px}
  .btn{border:1px solid var(--ink);background:none;color:var(--ink);border-radius:99px;
       padding:14px 30px;font-family:inherit;font-size:.98rem;font-weight:300;cursor:pointer;
       transition:.3s cubic-bezier(.2,.7,.2,1)}
  .btn--primary{background:var(--clay);border-color:var(--clay);color:#fff;flex:1;font-weight:400}
  @media (hover:hover){
    .btn--primary:hover{background:var(--clay-deep);border-color:var(--clay-deep)}
    .btn--ghost:hover{border-color:var(--ink-soft);color:var(--ink-soft)}
  }
  .btn--ghost{border-color:var(--line);color:var(--ink-soft);padding:14px 22px}
  .btn[disabled]{opacity:.55;cursor:default}
  .btn--hidden{visibility:hidden;pointer-events:none}

  /* ---------- done ---------- */
  .done{display:none;padding:12vh 0 10vh;text-align:center}
  .done.on{display:block;animation:rise .6s cubic-bezier(.2,.7,.2,1) both}
  .done__mark{width:66px;margin:0 auto 26px}
  .done h2{font-family:var(--display);font-weight:400;font-size:clamp(1.8rem,5vw,2.5rem);
           line-height:1.3;margin-bottom:18px}
  .done p{color:var(--ink-soft);max-width:46ch;margin:0 auto 12px;font-size:1.03rem}
  .done__sig{margin-top:30px;font-size:.95rem;color:var(--ink);line-height:1.9}
  .done__sig span{display:block;color:var(--clay-deep);font-size:.82rem;letter-spacing:.1em}

  .sending{display:none;align-items:center;justify-content:center;gap:10px;
           color:var(--ink-soft);font-size:.92rem}
  .sending.on{display:flex}
  .spin{width:15px;height:15px;border:2px solid var(--line);border-top-color:var(--clay);
        border-radius:50%;animation:sp .8s linear infinite}
  @keyframes sp{to{transform:rotate(360deg)}}

  .fail{display:none;margin-top:16px;background:var(--clay-tint);border:1px solid #E7CDBF;
        border-radius:var(--r);padding:16px 18px;font-size:.94rem;color:var(--clay-deep)}
  .fail.on{display:block}
  .fail a{color:var(--clay-deep);text-decoration:underline;text-underline-offset:3px}

  @media (max-width:560px){
    main{padding:0 18px 150px}
    .q-top__in{padding:12px 18px 0}
    .q-logo{width:158px}
    .step{padding:38px 0 8px}
    .q{margin-top:30px}
    .btn{padding:15px 22px}
    .btn--ghost{padding:15px 18px}
  }
</style>

<header class="q-top">
  <div class="q-top__in">
    <img class="q-logo" src="/assets/logo.png" alt="Sharon Sagie · interior design & home planning" />
    <div class="q-bar"><div class="q-bar__fill" id="barFill"></div></div>
    <div class="q-meta">
      <span id="stepLabel">לפני שמתחילים</span>
      <span><strong id="pct">0%</strong></span>
    </div>
  </div>
</header>

<main>
  <form id="qForm" novalidate>

    <!-- ===== INTRO ===== -->
    <section class="step intro on" data-step="0" data-title="לפני שמתחילים">
      <span class="eyebrow">Make it Right</span>
      <h1>לקראת פגישת הייעוץ<br />התכנוני <em>שלנו</em></h1>
      <div class="rule"></div>
      <p>המטרה של השאלון היא לאפשר לי להכיר קצת יותר אתכם, את הבית שאתם מתכננים ואת הדברים שחשובים לכם באמת – עוד לפני שניפגש.</p>
      <p>ככל שאכיר טוב יותר את שגרת החיים, הצרכים וההתלבטויות שלכם, נוכל לנצל את הפגישה בצורה מדויקת ויעילה יותר ולבחון את התכנון לא רק על הנייר, אלא דרך החיים שעתידים להתקיים בו.</p>
      <p>אין תשובות נכונות או לא נכונות – פשוט ספרו לי איך אתם מדמיינים את הבית שלכם.</p>
      <span class="intro__pill">כ־10 דקות · אפשר לעצור ולחזור בהמשך</span>
    </section>

    <!-- ===== 1 · נעים להכיר ===== -->
    <section class="step" data-step="1" data-part="נעים להכיר" data-title="נעים להכיר">
      <span class="eyebrow">חלק 1 · נעים להכיר</span>
      <h2>נעים להכיר</h2>

      <div class="q" data-q="שמות" data-required="1">
        <label class="q__label" for="f_names">שמות<span class="req">*</span></label>
        <input type="text" id="f_names" name="שמות" autocomplete="name" placeholder="למשל: דנה ויואב לוי" />
        <p class="err">נשמח לדעת עם מי אנחנו מדברים</p>
      </div>

      <div class="q" data-q="יישוב שבו נבנה הבית" data-required="1">
        <label class="q__label" for="f_city">יישוב שבו נבנה הבית<span class="req">*</span></label>
        <input type="text" id="f_city" name="יישוב שבו נבנה הבית" placeholder="למשל: זיכרון יעקב" />
        <p class="err">שדה חובה</p>
      </div>
    </section>

    <section class="step" data-step="2" data-part="נעים להכיר" data-title="מי גר בבית">
      <span class="eyebrow">חלק 1 · נעים להכיר</span>
      <h2>מי עתיד לגור בבית?</h2>

      <div class="q" data-q="מי עתיד לגור בבית" data-required="1">
        <label class="q__label" for="f_people">מספר הנפשות וגילאי הילדים<span class="req">*</span>
          <span class="q__hint">למשל: 2 מבוגרים + 3 ילדים בני 12, 9 ו־4</span>
        </label>
        <textarea id="f_people" name="מי עתיד לגור בבית" placeholder="ספרו לי מי גר בבית ובאילו גילאים"></textarea>
        <p class="err">שדה חובה</p>
      </div>

      <div class="q" data-q="בעלי חיים">
        <span class="q__label">האם יש בעלי חיים בבית?<span class="opt">לא חובה</span></span>
        <div class="opts">
          <label class="opt-item"><input type="radio" name="בעלי חיים" value="כן" data-reveal="pets_more" /><span>כן</span></label>
          <label class="opt-item"><input type="radio" name="בעלי חיים" value="לא" /><span>לא</span></label>
        </div>
        <div class="other-wrap" id="pets_more">
          <input type="text" name="פירוט בעלי חיים" placeholder="אילו? יש משהו שחשוב שאדע לגביהם?" />
        </div>
      </div>
    </section>

    <section class="step" data-step="3" data-part="נעים להכיר" data-title="הבית והמגרש">
      <span class="eyebrow">חלק 1 · נעים להכיר</span>
      <h2>הבית והמגרש</h2>

      <div class="q" data-q="גודל המגרש">
        <label class="q__label" for="f_plot">מה גודל המגרש?<span class="opt">לא חובה</span></label>
        <input type="text" id="f_plot" name="גודל המגרש" class="in-short" placeholder="למשל: 500 מ״ר" />
      </div>

      <div class="q" data-q="שטח הבית המתוכנן">
        <label class="q__label" for="f_area">מה שטח הבית המתוכנן?<span class="opt">לא חובה</span></label>
        <input type="text" id="f_area" name="שטח הבית המתוכנן" class="in-short" placeholder="למשל: 220 מ״ר" />
      </div>

      <div class="q" data-q="מספר קומות">
        <span class="q__label">כמה קומות מתוכננות?<span class="opt">לא חובה</span></span>
        <div class="opts">
          <label class="opt-item"><input type="radio" name="מספר קומות" value="קומה אחת" /><span>קומה אחת</span></label>
          <label class="opt-item"><input type="radio" name="מספר קומות" value="שתי קומות" /><span>שתי קומות</span></label>
          <label class="opt-item"><input type="radio" name="מספר קומות" value="שתי קומות + מרתף" /><span>שתי קומות + מרתף</span></label>
          <label class="opt-item"><input type="radio" name="מספר קומות" value="שלוש קומות ומעלה" /><span>שלוש ומעלה</span></label>
          <label class="opt-item"><input type="radio" name="מספר קומות" value="אחר" data-reveal="floors_other" /><span>אחר</span></label>
        </div>
        <div class="other-wrap" id="floors_other">
          <input type="text" name="מספר קומות · אחר" placeholder="פרטו" />
        </div>
      </div>

      <div class="q" data-q="שלב התכנון" data-required="1">
        <span class="q__label">באיזה שלב נמצא התכנון כרגע?<span class="req">*</span></span>
        <div class="opts opts--col">
          <label class="opt-item"><input type="radio" name="שלב התכנון" value="סקיצות ראשוניות" /><span>סקיצות ראשוניות</span></label>
          <label class="opt-item"><input type="radio" name="שלב התכנון" value="תכנון מתקדם" /><span>תכנון מתקדם</span></label>
          <label class="opt-item"><input type="radio" name="שלב התכנון" value="תכנית כמעט סופית לפני הגשה להיתר" /><span>תכנית כמעט סופית לפני הגשה להיתר</span></label>
          <label class="opt-item"><input type="radio" name="שלב התכנון" value="אחר" data-reveal="stage_other" /><span>אחר</span></label>
        </div>
        <div class="other-wrap" id="stage_other">
          <input type="text" name="שלב התכנון · אחר" placeholder="פרטו" />
        </div>
        <p class="err">בחרו את השלב שהכי מתאים</p>
      </div>
    </section>

    <!-- ===== 2 · החיים בבית ===== -->
    <section class="step" data-step="4" data-part="החיים בבית" data-title="שגרת החיים">
      <span class="eyebrow">חלק 2 · בואו נדבר על החיים בבית</span>
      <h2>ספרו לי קצת על שגרת החיים שלכם בבית</h2>
      <p class="step__note">מי נמצא בבית ובאילו שעות? איפה אתם מבלים יחד? ומה קורה בבית ביום טיפוסי?</p>

      <div class="q" data-q="שגרת החיים בבית">
        <label class="q__label" for="f_routine">היום שלכם, במילים שלכם<span class="opt">לא חובה</span></label>
        <textarea id="f_routine" name="שגרת החיים בבית" placeholder="בוקר, צהריים, ערב… מה קורה בבית ואיפה"></textarea>
      </div>
    </section>

    <section class="step" data-step="5" data-part="החיים בבית" data-title="אירוח">
      <span class="eyebrow">חלק 2 · בואו נדבר על החיים בבית</span>
      <h2>עד כמה אתם מארחים?</h2>

      <div class="q" data-q="תדירות אירוח">
        <span class="q__label">התדירות שהכי מתאימה<span class="opt">לא חובה</span></span>
        <div class="opts opts--col">
          <label class="opt-item"><input type="radio" name="תדירות אירוח" value="כמעט ולא" /><span>כמעט ולא</span></label>
          <label class="opt-item"><input type="radio" name="תדירות אירוח" value="מדי פעם" /><span>מדי פעם</span></label>
          <label class="opt-item"><input type="radio" name="תדירות אירוח" value="לעיתים קרובות" /><span>לעיתים קרובות</span></label>
